# Supabase Ienvia. Copie para .env.local; não versione valores reais.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use uma chave publishable sb_publishable_... (ou legacy anon); nunca use service_role aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_SUA_CHAVE_PUBLICA
# Service-role é proibida no browser e não é necessária para os fluxos RLS atuais.
# Só adicione-a em ambiente server-only se um fluxo administrativo auditado precisar dela.
